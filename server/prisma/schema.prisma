generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  HQ_ADMIN
  REGIONAL_MANAGER
  FRANCHISEE
  AP_CLERK
  AUDITOR
}

enum StagingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  APPROVED
  VOID
}

enum BatchStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Tenancy: Organization -> Location -> User
// ---------------------------------------------------------------------------

model Organization {
  name      String
  locations Location[]
  users     User[]
  vendors   Vendor[]
  invoices  Invoice[]
  batches   ImportBatch[]
  staging   InvoiceStaging[]
  auditLogs AuditLog[]
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model Location {
  code           String
  name           String
  currency       String       @default("USD")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoices       Invoice[]
  staging        InvoiceStaging[]
  batches        ImportBatch[]
  users          UserLocation[]
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())

  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  name           String
  email          String       @unique
  role           UserRole     @default(AP_CLERK)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  locations      UserLocation[]
  approvedStaged InvoiceStaging[] @relation("StagingReviewer")
  approvedInvoice Invoice[]      @relation("InvoiceApprover")
  auditLogs      AuditLog[]
  batches        ImportBatch[]
  passwordHash   String
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model UserLocation {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Vendors & invoices
// ---------------------------------------------------------------------------

model Vendor {
  name           String
  email          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoices       Invoice[]
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model InvoiceStaging {
  invoiceNumber String
  vendorName    String?
  vendorEmail   String?
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @db.Date
  status        StagingStatus @default(PENDING)
  rejectReason  String?
  batchId       String
  batch         ImportBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id])
  reviewedById   String?
  reviewedBy     User?         @relation("StagingReviewer", fields: [reviewedById], references: [id])
  rawRow         Json?
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())

  @@unique([batchId, invoiceNumber])
  @@index([organizationId, status])
  @@index([locationId, status])
}

model Invoice {
  invoiceNumber String
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @db.Date
  status        InvoiceStatus @default(APPROVED)
  vendorEmail   String?
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  locationId     String
  location       Location      @relation(fields: [locationId], references: [id])
  batchId        String?
  approvedById   String?
  approvedBy     User?         @relation("InvoiceApprover", fields: [approvedById], references: [id])
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Same invoice number can exist per location+vendor (two stores, same vendor number)
  @@unique([locationId, vendorId, invoiceNumber])
  @@index([organizationId, date])
  @@index([locationId, date])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Import batches & audit trail
// ---------------------------------------------------------------------------

model ImportBatch {
  fileName      String
  status        BatchStatus @default(COMPLETED)
  totalRows     Int         @default(0)
  importedRows  Int         @default(0)
  duplicateRows Int         @default(0)
  failedRows    Int         @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id])
  uploadedById   String
  uploadedBy     User        @relation(fields: [uploadedById], references: [id])
  failures       Json?
  staging        InvoiceStaging[]
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  action         String
  entityType     String
  entityId       String
  actorEmail     String
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  metadata       Json?
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}
