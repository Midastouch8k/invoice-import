PORT=8080
NODE_ENV=development

# PostgreSQL connection string (e.g. Neon, Supabase, local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/invoice_import?sslmode=require

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Comma-free CORS origin of the deployed client (localhost origins are always allowed)
CLIENT_URL=http://localhost:5173
